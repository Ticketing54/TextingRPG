  m_Script: {fileID: 11500000, guid: 5ed1a5d64049588438c22506a40ab64d, type: 3}
  m_Name: GertStoryGraph
  m_EditorClassIdentifier: TextingRPG.Runtime::TextingRPG.Story.StoryGraph
  NpcId: innkeeper_gert
  StartNodeId: start
  Nodes:
  - NodeId: start
    SceneDescription: "\uD50C\uB808\uC774\uC5B4\uAC00 \uBC29\uAE08 \uC5EC\uAD00 \uBB38\uC744
      \uC5F4\uACE0 \uB4E4\uC5B4\uC654\uB2E4. \uB2A6\uC740 \uC800\uB141\uC774\uB77C
      \uC190\uB2D8\uC740 \uAC70\uC758 \uC5C6\uACE0, \uBCBD\uB09C\uB85C \uC55E\uC5D0
      \uAC8C\uB974\uD2B8\uAC00 \uC190\uB2D8\uC744 \uB9DE\uC774\uD560 \uC900\uBE44\uB97C
      \uD558\uACE0 \uC788\uB2E4."
    Transitions:
    - Tag: friendly
      NextNodeId: chat
    - Tag: hostile
      NextNodeId: wary
  - NodeId: chat
    SceneDescription: "\uD50C\uB808\uC774\uC5B4\uC640 \uAC8C\uB974\uD2B8\uAC00 \uD3B8\uD558\uAC8C
      \uB300\uD654\uB97C \uB098\uB204\uACE0 \uC788\uB2E4. \uAC8C\uB974\uD2B8\uB294
      \uC5EC\uD589\uC790\uB4E4\uC758 \uC774\uC57C\uAE30\uB97C \uB4E3\uB294 \uAC78
      \uC88B\uC544\uD55C\uB2E4."
    Transitions:
    - Tag: ask_room
      NextNodeId: room
    - Tag: ask_rumor
      NextNodeId: rumor
  - NodeId: wary
    SceneDescription: "\uD50C\uB808\uC774\uC5B4\uAC00 \uAC8C\uB974\uD2B8\uC5D0\uAC8C
      \uBB34\uB840\uD558\uAC70\uB098 \uC704\uD611\uC801\uC73C\uB85C \uAD74\uC5B4\uC11C,
      \uAC8C\uB974\uD2B8\uAC00 \uACBD\uACC4\uD558\uBA70 \uAC70\uB9AC\uB97C \uB450\uACE0
      \uC788\uB2E4."
    Transitions:
    - Tag: apologize
      NextNodeId: chat
    - Tag: threaten
      NextNodeId: kicked_out
  - NodeId: room
    SceneDescription: "\uD50C\uB808\uC774\uC5B4\uAC00 \uBC29\uC744 \uC7A1\uAE30\uB85C
      \uD588\uB2E4. \uAC8C\uB974\uD2B8\uAC00 \uC5F4\uC1E0\uB97C \uAC74\uB124\uC8FC\uBA70
      \uC548\uB0B4\uD55C\uB2E4."
    Transitions: []
  - NodeId: rumor
    SceneDescription: "\uAC8C\uB974\uD2B8\uAC00 \uB9C8\uC744\uC5D0 \uB5A0\uB3C4\uB294
      \uC18C\uBB38 \uD558\uB098\uB97C \uB4E4\uB824\uC8FC\uACE0 \uC788\uB2E4."
    Transitions: []
  - NodeId: kicked_out
    SceneDescription: "\uAC8C\uB974\uD2B8\uAC00 \uD654\uAC00 \uB098\uC11C \uD50C\uB808\uC774\uC5B4\uB97C
      \uC5EC\uAD00 \uBC16\uC73C\uB85C \uCAD3\uC544\uB0C8\uB2E4."
    Transitions: []
